[Unit]
Description=FGBears YouTube freeze-box trivia packet router
After=network-online.target fgbears-live.service
Wants=network-online.target
Requires=fgbears-live.service
StartLimitIntervalSec=30min
StartLimitBurst=6

[Service]
Type=simple
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GST_REGISTRY=/tmp/fgbears-youtube-router-gst-registry.bin
Environment=FGB_YOUTUBE_ROUTER_BASE=/opt/fgbears-live/bin/youtube-stream-router-emergency.py
ExecStart=/usr/bin/python3 /opt/fgbears-live/bin/youtube-stream-router-freezebox.py --card /var/lib/fgbears-live/youtube-freeze-card.h264 --log-level INFO
Restart=on-failure
RestartSec=5
SuccessExitStatus=130 143
TimeoutStopSec=15
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/fgbears-live /etc/fgbears-live /var/lib/fgbears-live
RestrictSUIDSGID=true
LockPersonality=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
