[Unit]
Description=FGBears YouTube freeze-frame trivia card refresh
After=network-online.target fgbears-live.service
Wants=network-online.target
Requires=fgbears-live.service

[Service]
Type=oneshot
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
ExecStart=/usr/local/bin/fgbears-youtube-freeze-card-refresh
Nice=19
IOSchedulingClass=idle
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/fgbears-live /etc/fgbears-live
ReadWritePaths=/var/lib/fgbears-live
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStartSec=90
