# Copy to /etc/fgbears-live/stream.env and restrict permissions to root.
# Never commit an actual YouTube or Rumble stream key.
YOUTUBE_STREAM_KEY=REPLACE_WITH_YOUTUBE_STREAM_KEY
YOUTUBE_LOCAL_UDP_URL=udp://127.0.0.1:1939?pkt_size=1316
YOUTUBE_UPSTREAM_RTMP_BASE=rtmps://a.rtmps.youtube.com/live2
YOUTUBE_AUDIO_BITRATE=128k
YOUTUBE_AUDIO_SAMPLE_RATE=44100
YOUTUBE_AUDIO_CHANNELS=2
FGB_YOUTUBE_PACKET_ROUTER_ENABLE=0
YOUTUBE_VIDEO_BITRATE=5000k
YOUTUBE_VIDEO_MAXRATE=5500k
YOUTUBE_VIDEO_BUFSIZE=10000k
RUMBLE_TRIVIA_URL=https://rumble.com/v7eqrsu-chicago-bears-live-trivia-every-20-minutes-cash-prizes-fgb.html
RUMBLE_TRIVIA_DISPLAY_URL=rumble.com/v7eqrsu
RUMBLE_STREAM_KEY=REPLACE_WITH_RUMBLE_STREAM_KEY
RUMBLE_LOCAL_UDP_URL=udp://127.0.0.1:1940?pkt_size=1316
RUMBLE_UPSTREAM_RTMP_BASE=rtmp://rtmp.rumble.com/live
PLAYLIST_FILE=/srv/fgbears-live/playlist.ffconcat
FFMPEG_LOGLEVEL=warning
# The media library is normalized to 30 fps CFR; keep the live program on the
# same cadence to avoid periodic frame drops/judder from 30->24 conversion.
OUTPUT_FPS=30
VIDEO_GOP=60
DRAWTEXT_RELOAD_FRAMES=30
# Program mastering is offline-only (fgb-podcast-v2-mastered). The shared live
# master copies that AAC unchanged. Rumble copy-remuxes it unchanged. YouTube
# keeps H.264 by copy but regenerates AAC-LC at 44.1 kHz stereo / 128 kb/s with
# async resampling solely to provide clean platform-specific AAC timestamps.

SPONSOR_FEED_URL=https://epiccontentcreatorgrants.org/api/public/fgbears/sponsors
SPONSOR_POLL_SECONDS=10
AD_ROTATION_SECONDS=20
AD_OVERLAY_PORT=8787
AD_OVERLAY_FPS=15

GAME_SCREEN_FEED_URL=https://epiccontentcreatorgrants.org/api/public/fgbears/game-screen
GAME_SCREEN_POLL_SECONDS=2
GAME_PLAY_BASE_URL=https://epiccontentcreatorgrants.org

BEARS_NEWS_FEED_URL=https://raw.githubusercontent.com/mrkenapierce/FGB-Production-Studio/main/feeds/fgb-bears-news.xml
BEARS_NEWS_POLL_SECONDS=300
BEARS_NEWS_MAX_ITEMS=8
BEARS_NEWS_SCROLL_PPS=76
BEARS_NEWS_OVERLAY_PORT=8789
BEARS_NEWS_OVERLAY_FPS=15

CRAWL_FEED_URL=https://epiccontentcreatorgrants.org/api/public/fgbears/crawl
CRAWL_POLL_SECONDS=5
CRAWL_OVERLAY_PORT=8788
CRAWL_OVERLAY_FPS=30
