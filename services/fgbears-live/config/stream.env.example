# Copy to /etc/fgbears-live/stream.env and restrict permissions to root.
# Never commit an actual YouTube stream key.
YOUTUBE_STREAM_KEY=REPLACE_WITH_YOUTUBE_STREAM_KEY
YOUTUBE_RTMP_BASE=rtmps://a.rtmps.youtube.com/live2
PLAYLIST_FILE=/srv/fgbears-live/playlist.ffconcat
FFMPEG_LOGLEVEL=warning
OUTPUT_FPS=24
VIDEO_GOP=48
DRAWTEXT_RELOAD_FRAMES=24

# Dynamic Football's Greatest Bears advertising overlay.
# Existing installations may omit these because the renderer has safe defaults.
SPONSOR_FEED_URL=https://epiccontentcreatorgrants.org/api/public/fgbears/sponsors
SPONSOR_POLL_SECONDS=10
AD_ROTATION_SECONDS=20
AD_OVERLAY_PORT=8787
AD_OVERLAY_FPS=25
# The advertising layout is the permanent video output; source video is hidden.

# FGB-owned Chicago Bears news RSS feed. The poller publishes one continuous
# upper-third text ribbon. FFmpeg renders it natively so the stream keeps one
# video clock and the headline enters/exits beneath orange boundary masks.
BEARS_NEWS_FEED_URL=https://raw.githubusercontent.com/mrkenapierce/FGB-Production-Studio/main/feeds/fgb-bears-news.xml
BEARS_NEWS_POLL_SECONDS=300
BEARS_NEWS_MAX_ITEMS=8
BEARS_NEWS_SCROLL_PPS=90

# Live lower-third crawl controlled from EPIC Admin.
CRAWL_FEED_URL=https://epiccontentcreatorgrants.org/api/public/fgbears/crawl
CRAWL_POLL_SECONDS=5
CRAWL_OVERLAY_PORT=8788
CRAWL_OVERLAY_FPS=15
