# FGBears production stream configuration template.
# Copy to /etc/fgbears-live/stream.env and protect the live stream keys.

# Shared program -> isolated local mirrors.
YOUTUBE_STREAM_KEY=REPLACE_WITH_YOUTUBE_STREAM_KEY
YOUTUBE_LOCAL_UDP_URL=udp://127.0.0.1:1939?pkt_size=1316
YOUTUBE_V3_BUFFERED_UDP_URL=udp://127.0.0.1:1941?pkt_size=1316
YOUTUBE_V3_BUFFER_SECONDS=4
YOUTUBE_UPSTREAM_RTMP_BASE=rtmps://a.rtmps.youtube.com/live2
YOUTUBE_SERVICE=fgbears-youtube-v3.service
YOUTUBE_PROGRESS_FILE=/run/fgbears-youtube-v3/ffmpeg-progress.log

RUMBLE_STREAM_KEY=REPLACE_WITH_RUMBLE_STREAM_KEY
RUMBLE_LOCAL_UDP_URL=udp://127.0.0.1:1940?pkt_size=1316
RUMBLE_UPSTREAM_RTMP_BASE=rtmp://rtmp.rumble.com/live

# Lovable publishes control state only. The v3 media clock is independent from
# routing requests; approved creatives are local files only. The YouTube-only
# playout reserve and concealment trigger use the same four-second delay.
FGB_STREAM_ROUTING_URL=https://epiccontentcreatorgrants.org/api/public/fgbears/stream-routing
YOUTUBE_V3_CREATIVE_DIR=/opt/fgbears-live/youtube-v3/creatives

RUMBLE_TRIVIA_URL=https://rumble.com/v7eqrsu-chicago-bears-live-trivia-every-20-minutes-cash-prizes-fgb.html
RUMBLE_TRIVIA_DISPLAY_URL=rumble.com/v7eqrsu

PLAYLIST_FILE=/srv/fgbears-live/playlist.ffconcat
FFMPEG_LOGLEVEL=warning
OUTPUT_FPS=30
VIDEO_GOP=60

AD_OVERLAY_PORT=8787
AD_OVERLAY_FPS=15
AD_OVERLAY_SCRIPT=/opt/fgbears-live/bin/ad-overlay.py
CRAWL_OVERLAY_PORT=8788
CRAWL_OVERLAY_FPS=30
CRAWL_OVERLAY_SCRIPT=/opt/fgbears-live/bin/crawl-overlay-hq.py
CRAWL_TEXT_RENDER_SCALE=2
BEARS_NEWS_OVERLAY_PORT=8789
BEARS_NEWS_OVERLAY_FPS=30
BEARS_NEWS_SCROLL_PPS=58

FFMPEG_PROGRESS_FILE=/srv/fgbears-live/logs/ffmpeg-progress.log
FGB_YOUTUBE_PACKET_ROUTER_ENABLE=0
