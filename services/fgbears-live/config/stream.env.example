# Copy to /etc/fgbears-live/stream.env and restrict permissions to root.
# Never commit an actual YouTube, X, or Facebook stream key.
YOUTUBE_STREAM_KEY=REPLACE_WITH_YOUTUBE_STREAM_KEY
# The primary encoder continuously emits its already-encoded H.264/AAC program
# to this connectionless loopback MPEG-TS mirror. The YouTube relay can restart
# independently and rejoin at the next keyframe without freezing the encoder.
YOUTUBE_LOCAL_UDP_URL=udp://127.0.0.1:1939?pkt_size=1316
YOUTUBE_UPSTREAM_RTMP_BASE=rtmps://a.rtmps.youtube.com/live2

# Football's Greatest Bears X destination. The RTMP Source credentials must be
# created while signed in to this account so the video is published there.
X_ACCOUNT_HANDLE=@epic501c3
X_STREAM_ENABLED=0
X_RELAY_ENABLED=0
X_LOCAL_UDP_URL=udp://127.0.0.1:1937?pkt_size=1316
X_RTMP_BASE=
X_STREAM_KEY=
X_SCHEDULE_TIMEZONE=America/Chicago
X_SCHEDULE_START=09:00
X_SCHEDULE_STOP=17:00

# Facebook is never sent directly from the primary encoder. The primary process
# always emits the same already-encoded program to this loopback UDP mirror.
# A separate copy-remux sidecar sends it to Meta only during the scheduled window.
FACEBOOK_STREAM_ENABLED=0
FACEBOOK_RELAY_ENABLED=0
FACEBOOK_LOCAL_UDP_URL=udp://127.0.0.1:1936?pkt_size=1316
FACEBOOK_RTMP_BASE=rtmps://live-api-s.facebook.com:443/rtmp/
FACEBOOK_STREAM_KEY=
FACEBOOK_SCHEDULE_TIMEZONE=America/Chicago
FACEBOOK_SCHEDULE_START=09:00
FACEBOOK_SCHEDULE_STOP=17:00

# Instagram is emitted to a separate loopback mirror and converted to a
# vertical canvas by its isolated scheduled sidecar.
INSTAGRAM_ACCOUNT_HANDLE=@epic501c3
INSTAGRAM_RELAY_ENABLED=0
INSTAGRAM_LOCAL_UDP_URL=udp://127.0.0.1:1938?pkt_size=1316
INSTAGRAM_STREAM_URL=
INSTAGRAM_STREAM_KEY=
INSTAGRAM_SCHEDULE_TIMEZONE=America/Chicago
INSTAGRAM_SCHEDULE_START=09:00
INSTAGRAM_SCHEDULE_STOP=17:00

# X Live Studio currently caps each public livestream at 24 hours, but the same
# Source may be reused across successive livestreams.
PLAYLIST_FILE=/srv/fgbears-live/playlist.ffconcat
FFMPEG_LOGLEVEL=warning
OUTPUT_FPS=30
VIDEO_GOP=60
DRAWTEXT_RELOAD_FRAMES=30

# Dynamic Football's Greatest Bears advertising overlay.
# Existing installations may omit these because the renderer has safe defaults.
SPONSOR_FEED_URL=https://epiccontentcreatorgrants.org/api/public/fgbears/sponsors
SPONSOR_POLL_SECONDS=10
AD_ROTATION_SECONDS=20
AD_OVERLAY_PORT=8787
AD_OVERLAY_FPS=30
# The advertising layout is the permanent video output; source video is hidden.

# Optional FGB trivia game screen. This is consumed by the SAME ad renderer;
# inactive/unreachable game state leaves advertising behavior unchanged.
GAME_SCREEN_FEED_URL=https://epiccontentcreatorgrants.org/api/public/fgbears/game-screen
GAME_SCREEN_POLL_SECONDS=2
GAME_PLAY_BASE_URL=https://epiccontentcreatorgrants.org

# FGB-owned Chicago Bears news RSS feed. The poller publishes one continuous
# upper-third text ribbon. FFmpeg renders it natively so the stream keeps one
# video clock and the headline enters/exits beneath orange boundary masks.
BEARS_NEWS_FEED_URL=https://raw.githubusercontent.com/mrkenapierce/FGB-Production-Studio/main/feeds/fgb-bears-news.xml
BEARS_NEWS_POLL_SECONDS=300
BEARS_NEWS_MAX_ITEMS=8
BEARS_NEWS_SCROLL_PPS=90

# Live lower-third crawl controlled from EPIC Admin.
CRAWL_FEED_URL=https://epiccontentcreatorgrants.org/api/public/fgbears/crawl
CRAWL_POLL_SECONDS=5
CRAWL_OVERLAY_PORT=8788
CRAWL_OVERLAY_FPS=30
