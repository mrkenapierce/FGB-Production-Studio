[Unit]
Description=FGBears YouTube v3.6 production output
After=network-online.target fgbears-youtube-v3-source.service
Wants=network-online.target

[Service]
Type=simple
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
ExecStart=/opt/fgbears-live/youtube-v3/run-youtube-v3.sh
Restart=no
TimeoutStopSec=8
KillSignal=SIGINT
Nice=10
CPUWeight=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/fgbears-live /etc/fgbears-live
ReadWritePaths=/run/fgbears-youtube-v3

[Install]
WantedBy=multi-user.target
