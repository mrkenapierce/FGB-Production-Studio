[Unit]
Description=FGBears YouTube v3 isolated output
After=network-online.target fgbears-live.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=simple
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
Environment=YOUTUBE_V3_STATE_FILE=/run/fgbears-youtube-v3/overlay-state.json
Environment=YOUTUBE_V3_CREATIVE_DIR=/opt/fgbears-live/youtube-v3/creatives
ExecStart=/opt/fgbears-live/youtube-v3/run-youtube-v3.sh
Restart=on-failure
RestartSec=8
TimeoutStopSec=8
KillSignal=SIGINT
RuntimeDirectory=fgbears-youtube-v3
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/fgbears-live /etc/fgbears-live
ReadWritePaths=/run/fgbears-youtube-v3

[Install]
WantedBy=multi-user.target
