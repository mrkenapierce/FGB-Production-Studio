[Unit]
Description=FGBears YouTube v2 isolated output
After=network-online.target fgbears-live.service fgbears-lovable-state-cache.service
Wants=network-online.target fgbears-lovable-state-cache.service
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=simple
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
Environment=PYTHONPATH=/opt/fgbears-live/exact-card-pylib
Environment=FGB_CONTROL_STATE_FILE=/run/fgbears-control-plane/stream-state.json
ExecStart=/opt/fgbears-live/youtube-v2/run-youtube-v2.sh
Restart=on-failure
RestartSec=8
TimeoutStopSec=8
KillSignal=SIGINT
Nice=10
CPUWeight=20
RuntimeDirectory=fgbears-youtube-v2
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/fgbears-live /etc/fgbears-live /run/fgbears-control-plane
ReadWritePaths=/run/fgbears-youtube-v2

[Install]
WantedBy=multi-user.target
