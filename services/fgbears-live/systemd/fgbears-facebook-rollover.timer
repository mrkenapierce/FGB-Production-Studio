[Unit]
Description=Restart FGBears Facebook livestream every 8 hours on Central schedule

[Timer]
OnCalendar=*-*-* 03:00:00 America/Chicago
OnCalendar=*-*-* 11:00:00 America/Chicago
OnCalendar=*-*-* 19:00:00 America/Chicago
AccuracySec=1s
RandomizedDelaySec=0
Unit=fgbears-facebook-rollover.service

[Install]
WantedBy=timers.target
