[Unit]
Description=FGBears YouTube audio, transport, and frozen-output watchdog
After=network-online.target fgbears-live.service fgbears-youtube-lovable-routing.service fgbears-youtube-lovable-compositor.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/fgbears-live/bin/youtube-transport-watchdog.sh
TimeoutStartSec=45
