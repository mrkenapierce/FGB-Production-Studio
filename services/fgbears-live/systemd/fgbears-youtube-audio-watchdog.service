[Unit]
Description=FGBears YouTube owner-aware audio and transport watchdog
After=network-online.target fgbears-live.service fgbears-youtube-lovable-routing.service fgbears-youtube-lovable-compositor.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fgbears-youtube-audio-watchdog
TimeoutStartSec=45
