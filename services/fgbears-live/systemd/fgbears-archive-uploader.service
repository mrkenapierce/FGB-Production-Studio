[Unit]
Description=FGBears YouTube archive uploader
After=network-online.target fgbears-archive-recorder.service
Wants=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=20

[Service]
Type=simple
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
ExecStart=/usr/local/bin/fgbears-youtube-archive-upload
Restart=always
RestartSec=15
SuccessExitStatus=130 143
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/fgbears-live
ReadWritePaths=/srv/fgbears-live/archive
RestrictSUIDSGID=true
LockPersonality=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
