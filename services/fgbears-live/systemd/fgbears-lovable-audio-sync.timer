[Unit]
Description=QUARANTINED - legacy Lovable audio preparation poller
# No production activation is allowed. This unit is retained only for incident
# history and must remain masked on Oracle.
ConditionPathExists=/etc/fgbears-live/UNQUARANTINE_LEGACY_AUDIO_PREPARATION

[Timer]
OnCalendar=*-*-* *:*:00,15,30,45
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=fgbears-lovable-audio-sync.service

[Install]
WantedBy=timers.target
