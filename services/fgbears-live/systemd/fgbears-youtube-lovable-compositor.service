[Unit]
Description=FGBears YouTube Exact-Box Resource-Protected Compositor
After=network-online.target fgbears-live.service fgbears-youtube-lovable-routing.service
Wants=network-online.target
Requires=fgbears-youtube-lovable-routing.service

[Service]
Type=simple
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
RuntimeDirectory=fgbears-youtube-lovable-compositor
RuntimeDirectoryMode=0750
ExecStart=/opt/fgbears-live/bin/youtube-lovable-compositor.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillSignal=SIGINT
Nice=19
IOSchedulingClass=idle
CPUWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/fgbears-live /etc/fgbears-live

[Install]
WantedBy=multi-user.target
