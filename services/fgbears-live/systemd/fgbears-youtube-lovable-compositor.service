[Unit]
Description=FGBears YouTube Lovable-Controlled Resource-Protected 360p Compositor
After=network-online.target fgbears-live.service fgbears-youtube-lovable-routing.service
Wants=network-online.target
Requires=fgbears-youtube-lovable-routing.service

[Service]
Type=simple
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
Environment=YOUTUBE_QUESTION_MASK_PORT=8791
Environment=YOUTUBE_OUTPUT_WIDTH=640
Environment=YOUTUBE_OUTPUT_HEIGHT=360
Environment=YOUTUBE_OUTPUT_FPS=30
Environment=YOUTUBE_VIDEO_BITRATE=2200k
Environment=YOUTUBE_VIDEO_MAXRATE=2500k
Environment=YOUTUBE_VIDEO_BUFSIZE=4400k
Environment=YOUTUBE_UDP_FIFO_SIZE=16384
Environment=YOUTUBE_MASTER_THREAD_QUEUE=256
Environment=YOUTUBE_OVERLAY_THREAD_QUEUE=32
Environment=YOUTUBE_MONITOR_DIR=/run/fgbears-youtube-lovable-compositor
RuntimeDirectory=fgbears-youtube-lovable-compositor
RuntimeDirectoryMode=0750
ExecStart=/opt/fgbears-live/bin/youtube-lovable-compositor.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillSignal=SIGINT
Nice=19
IOSchedulingClass=idle
CPUWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/fgbears-live /etc/fgbears-live

[Install]
WantedBy=multi-user.target
