[Unit]
Description=FGBears TV 24/7 YouTube replay stream
After=network-online.target fgbears-youtube-relay.service
Wants=network-online.target fgbears-youtube-relay.service
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=simple
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
# Safety invariant: Facebook is never allowed back into the primary FFmpeg tee.
ExecStartPre=/usr/bin/bash -c '! grep -Eq "^FACEBOOK_STREAM_ENABLED=(1|true|yes|on)$" /etc/fgbears-live/stream.env'
ExecStart=/usr/local/bin/fgbears-start-stream
Restart=on-failure
RestartSec=15
SuccessExitStatus=130 143
TimeoutStopSec=20
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/fgbears-live /etc/fgbears-live
ReadWritePaths=/srv/fgbears-live
RestrictSUIDSGID=true
LockPersonality=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
