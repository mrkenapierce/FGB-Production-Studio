[Unit]
Description=Football's Greatest Bears shared 24/7 program
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
ExecStart=/usr/local/bin/fgbears-start-stream
# This is a 24/7 master. Any process exit, including FFmpeg status 0, is an
# outage and must be recovered automatically.
Restart=always
RestartSec=15
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/fgbears-live
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fgbears-live

[Install]
WantedBy=multi-user.target
