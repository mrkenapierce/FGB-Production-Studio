[Unit]
Description=Football's Greatest Bears shared 24/7 program
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
ExecStart=/usr/local/bin/fgbears-start-stream
# The YouTube copy relay carries MPEG-TS timeline state. Every new master
# process starts a fresh timeline, so force the relay to attach fresh as well.
# --no-block avoids an ordering deadlock because the relay starts After= this unit.
ExecStartPost=+/usr/bin/systemctl --no-block restart fgbears-youtube-copy-relay.service
Restart=always
RestartSec=15
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/fgbears-live
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fgbears-live

[Install]
WantedBy=multi-user.target
