[Unit]
Description=QUARANTINED - legacy FGB Lovable 48 kHz audio preparation pipeline
After=network-online.target fgbears-live.service
Wants=network-online.target
# This legacy pathway performed 48 kHz mastering/preparation and is not permitted
# to touch production. It remains only for incident forensics. A deliberate
# break-glass marker would be required even if the systemd mask were removed.
ConditionPathExists=/etc/fgbears-live/UNQUARANTINE_LEGACY_AUDIO_PREPARATION
ConditionPathExists=/usr/local/bin/fgbears-lovable-audio-pipeline

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fgbears-lovable-audio-pipeline
TimeoutStartSec=1200
Nice=19
IOSchedulingClass=idle
CPUWeight=1
CPUQuota=25%
MemoryMax=384M
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/fgbears-live /run
