[Unit]
Description=FGBears YouTube Lovable Routing Consumer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fgbears
Group=fgbears
Environment=PYTHONPATH=/opt/fgbears-live/exact-card-pylib
Environment=FGB_STREAM_ROUTING_URL=https://epiccontentcreatorgrants.org/api/public/fgbears/stream-routing
Environment=YOUTUBE_QUESTION_MASK_PORT=8791
Environment=YOUTUBE_OUTPUT_CANVAS_WIDTH=1280
Environment=YOUTUBE_OUTPUT_CANVAS_HEIGHT=720
Environment=YOUTUBE_QUESTION_MASK_FPS=15
Environment=YOUTUBE_QUESTION_MASK_POLL_SECONDS=0.20
Environment=YOUTUBE_REDIRECT_CARD_BUILDER=/opt/fgbears-live/tools/build-youtube-rumble-trivia-card.py
ExecStart=/usr/bin/python3 /opt/fgbears-live/bin/youtube-question-mask.py
Restart=on-failure
RestartSec=3
Nice=19
IOSchedulingClass=idle
CPUWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/fgbears-live

[Install]
WantedBy=multi-user.target
