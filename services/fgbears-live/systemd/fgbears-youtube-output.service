[Unit]
Description=FGBears minimal YouTube output
After=network-online.target fgbears-live.service
Wants=network-online.target
Requires=fgbears-live.service

[Service]
Type=simple
User=fgbears
Group=fgbears
EnvironmentFile=/etc/fgbears-live/stream.env
Environment=PYTHONPATH=/opt/fgbears-live/exact-card-pylib
ExecStart=/opt/fgbears-live/bin/youtube-output-minimal.sh
Restart=always
RestartSec=3
TimeoutStopSec=8
KillSignal=SIGINT
Nice=10
CPUWeight=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/fgbears-live /etc/fgbears-live

[Install]
WantedBy=multi-user.target
