# CNT capture image — separate from the FGB Dockerfile so FGB builds never change.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium xvfb pulseaudio ffmpeg curl ca-certificates procps \
      fonts-dejavu-core fonts-liberation fonts-noto-color-emoji tini tzdata \
      python3 jq openssl util-linux \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 cnt
RUN install -d -o cnt -g cnt -m 700 /cnt-state /cnt-state/watchdog
WORKDIR /opt/cnt
COPY run-cnt.sh episode-lib.sh episode-cutter.sh cnt-rolling-recorder.sh cnt-daily-recorder.sh \
     cnt-archive-retention.sh archive-retention.py cnt-air-observer.py capture-watchdog.py \
     cnt-lifecycle.sh cnt-diagnostics.py cnt-preflight.py \
     cnt-destination-gate.sh cnt-destination-agent.py ./
RUN chmod +x *.sh cnt-air-observer.py capture-watchdog.py cnt-destination-agent.py
USER cnt

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD python3 ./capture-watchdog.py cnt health

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["./run-cnt.sh"]