BRIDGE_RENDER_TARGET=rumble
VIDEO_BITRATE=3000k
AUDIO_BITRATE=128k
STALL_SECONDS=20
RELOAD_EVERY_SECONDS=21600

# Daily livestream archive. The live YouTube leg is independent of these settings.
FGB_ARCHIVE_ENABLED=1
FGB_ARCHIVE_DIR=/archive
FGB_ARCHIVE_LOCAL_UDP_OUTPUT_URL=udp://127.0.0.1:1944?pkt_size=1316
FGB_ARCHIVE_LOCAL_UDP_URL=udp://127.0.0.1:1944?fifo_size=1000000&overrun_nonfatal=1&reuse=1
FGB_ARCHIVE_SEGMENT_SECONDS=3600
FGB_ARCHIVE_TIMEZONE=America/Chicago
FGB_ARCHIVE_PRIVACY=public
FGB_ARCHIVE_PLAYLIST_TITLE=FGB Daily Livestream Archive
FGB_ARCHIVE_POLL_SECONDS=60
FGB_ARCHIVE_STABLE_AGE_SECONDS=90
FGB_ARCHIVE_DAY_CLOSE_GRACE_SECONDS=180
FGB_ARCHIVE_MAX_PART_SECONDS=43200
FGB_ARCHIVE_MIN_FREE_GB=8
FGB_ARCHIVE_UPLOAD_ENABLED=1
FGB_YOUTUBE_CLIENT_ID=
FGB_YOUTUBE_CLIENT_SECRET=
FGB_YOUTUBE_REFRESH_TOKEN=
