[Unit]
Description=EPIC cnt receipt-gated archive cleanup (dry-run unless enabled in env file)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/epic-archive-cleanup/cnt.env
ExecStart=/usr/bin/python3 /opt/epic-archive-cleanup/archive-cleanup.py cnt
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/cnt-archive
TimeoutStartSec=600
