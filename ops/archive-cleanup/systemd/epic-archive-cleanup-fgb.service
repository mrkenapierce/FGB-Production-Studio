[Unit]
Description=EPIC fgb receipt-gated archive cleanup (dry-run unless enabled in env file)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/epic-archive-cleanup/fgb.env
ExecStart=/usr/bin/python3 /opt/epic-archive-cleanup/archive-cleanup.py fgb
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fgb-archive
TimeoutStartSec=600
