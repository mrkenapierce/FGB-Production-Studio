# CNT cleanup. Keep DRY_RUN=true until a dry run has been reviewed.
DRY_RUN=true
CLEANUP_CONFIRM_DELETE=no
RETENTION_HOURS=3
CLEANUP_ROOT=/cnt-archive
CNT_ARCHIVE_URL=https://epiccontentcreatorgrants.org/api/public/channels/cruisenewstrivia/archive
# Sent only as x-cnt-archive-key (CNT production contract; no HMAC headers).
CNT_ARCHIVE_HMAC_SECRET=
CLEANUP_REQUIRE_HOLDS=true
CLEANUP_HOLD_FILES=episode_hold daily_hold
