# FGB cleanup. Keep DRY_RUN=true until a dry run has been reviewed.
DRY_RUN=true
# Second gate: real deletion only when DRY_RUN=false AND this is exactly "yes".
CLEANUP_CONFIRM_DELETE=no
RETENTION_HOURS=3
CLEANUP_ROOT=/srv/fgb-archive
ARCHIVE_URL=https://epiccontentcreatorgrants.org/api/public/fgbears/archive
# Auth: FGB_ARCHIVE_API_KEY (static x-fgb-archive-key, preferred) OR the HMAC
# heartbeat secret. They are distinct values; never put one in the other.
FGB_ARCHIVE_API_KEY=
FGB_TRANSPORT_HEARTBEAT_SECRET=
# Holds must exist and be fresh (<10 min) or nothing is deleted. Set false only
# if no episode/daily job on this channel can need older footage.
CLEANUP_REQUIRE_HOLDS=true
CLEANUP_HOLD_FILES=episode_hold
